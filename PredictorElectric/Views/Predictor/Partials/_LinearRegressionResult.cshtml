@model PredictorElectric.Business.Dtos.LinearRegressionDto
@using PredictorElectric.Helpers


<div class="card border-0 shadow-sm mt-4" style="border-left: 4px solid var(--accent) !important;">
	<div class="card-body">
		<h5 class="fw-semibold" style="color: var(--text-dark);">Predicción de Regresión Lineal</h5>
		<p class="mb-1">Consumo estimado para el mes 13: <strong>@Model.EstimatedConsumption.ToString("0.00")</strong> kWh</p>
		<p class="mb-1">Pendiente: <strong>@Model.Slope.ToString("0.00")</strong></p>
		<p class="mb-0">Tendencia: <strong>@TrendTypeHelper.ToTrendWording(Model.Tendency)</strong></p>
	</div>
</div>