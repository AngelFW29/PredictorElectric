@model PredictorElectric.Business.Dtos.SmaDto
@using PredictorElectric.Helpers

<div class="card border-0 shadow-sm mt-4" style="border-left: 4px solid var(--accent) !important;">
	<div class="card-body">
		<h5 class="fw-semibold" style="color: var(--text-dark);">Promedio Móvil Simple</h5>
		<p class="mb-1">Consumo estimado para el próximo mes: <strong>@Model.AvgConsumption.ToString("0.00")</strong> kWh</p>
		<p class="mb-0">Tendencia: <strong>@TrendTypeHelper.ToTrendWording(Model.Tendency)</strong></p>
	</div>
</div>